  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('cash', 'mobile_money', 'bank', 'savings')), \"opening_balance\" INTEGER NOT NULL CHECK(\"opening_balance\" >= 0), \"archived_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('expense', 'income')), \"icon\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES categories (id), \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('expense', 'income', 'transfer')), \"amount\" INTEGER NOT NULL CHECK(\"amount\" BETWEEN 1 AND 999999999), \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"to_account_id\" TEXT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"description\" TEXT NULL, \"occurred_at\" INTEGER NOT NULL, \"entry_method\" TEXT NOT NULL DEFAULT 'manual' CHECK(\"entry_method\" IN ('manual', 'voice', 'text', 'receipt', 'recurring')), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK ((kind = 'transfer' AND to_account_id IS NOT NULL AND to_account_id <> account_id AND category_id IS NULL) OR (kind <> 'transfer' AND to_account_id IS NULL AND category_id IS NOT NULL)));"
        }
      ]
    },
    {
      "name": "accounts_active_name_unique",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX accounts_active_name_unique ON accounts (lower(name)) WHERE archived_at IS NULL"
        }
      ]
    },
    {
      "name": "transactions_account",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX transactions_account ON transactions (account_id, occurred_at)"
        }
      ]
    },
    {
      "name": "transactions_to_account",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX transactions_to_account ON transactions (to_account_id)"
        }
      ]
    },
    {
      "name": "transactions_occurred_at",
      "sql": [
        {

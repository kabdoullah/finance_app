  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('cash', 'mobile_money', 'bank', 'savings')), \"opening_balance\" INTEGER NOT NULL CHECK(\"opening_balance\" >= 0), \"archived_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('expense', 'income')), \"icon\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES categories (id), \"sort_order\" INTEGER NOT NULL, \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"hidden_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurring_operations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_operations\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('expense', 'income')), \"name\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" BETWEEN 1 AND 999999999), \"is_variable\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_variable\" IN (0, 1)), \"category_id\" TEXT NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"frequency\" TEXT NOT NULL CHECK(\"frequency\" IN ('week', 'month', 'year')), \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"next_due_date\" TEXT NULL, \"ask_before_recording\" INTEGER NOT NULL DEFAULT 1 CHECK (\"ask_before_recording\" IN (0, 1)), \"paused_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('expense', 'income', 'transfer')), \"amount\" INTEGER NOT NULL CHECK(\"amount\" BETWEEN 1 AND 999999999), \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"to_account_id\" TEXT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"description\" TEXT NULL, \"occurred_at\" INTEGER NOT NULL, \"entry_method\" TEXT NOT NULL DEFAULT 'manual' CHECK(\"entry_method\" IN ('manual', 'voice', 'text', 'receipt', 'recurring')), \"recurring_id\" TEXT NULL REFERENCES recurring_operations (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK ((kind = 'transfer' AND to_account_id IS NOT NULL AND to_account_id <> account_id AND category_id IS NULL) OR (kind <> 'transfer' AND to_account_id IS NULL AND category_id IS NOT NULL)));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE CASCADE, \"limit_amount\" INTEGER NOT NULL CHECK(\"limit_amount\" BETWEEN 1 AND 999999999), \"alert_percent\" INTEGER NOT NULL CHECK(\"alert_percent\" BETWEEN 50 AND 100), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "savings_goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"savings_goals\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"target_amount\" INTEGER NOT NULL CHECK(\"target_amount\" BETWEEN 1 AND 9999999999), \"target_date\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {

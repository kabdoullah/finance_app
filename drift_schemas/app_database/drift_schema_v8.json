        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_movements\" (\"id\" TEXT NOT NULL, \"goal_id\" TEXT NOT NULL REFERENCES savings_goals (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('contribution', 'withdrawal')), \"amount\" INTEGER NOT NULL CHECK(\"amount\" BETWEEN 1 AND 9999999999), \"account_id\" TEXT NOT NULL REFERENCES accounts (id) ON DELETE CASCADE, \"occurred_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
